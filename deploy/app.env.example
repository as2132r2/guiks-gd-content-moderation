# Install as /etc/guiks-gd-content-moderation/app.env with mode 0600.
# Never commit the installed file or put live values in a shell command/history.
NODE_ENV=production
APP_MODE=production
PORT=3300
DATABASE_PATH=/var/lib/guiks-gd-content-moderation/app.db
FAIL_CLOSED=true
ALLOW_MOCK_UPSTREAM=false
MAX_AUDITS=500

# HTTP-only deployment: browsers discard a `Secure` cookie sent over http://,
# so login silently fails in the browser while curl still succeeds. Set this to
# true ONLY while the site has no HTTPS, and remove it once HTTPS is in place.
ALLOW_INSECURE_COOKIE=false

# Each must be a separately generated `base64:` value containing >=32 random bytes.
SESSION_SECRET=REPLACE_AT_DEPLOY_TIME
GATEWAY_TOKEN=REPLACE_AT_DEPLOY_TIME

# One-line JSON. Put provider URLs and keys only in the installed 0600 file.
# DeepSeek: thinking=disabled; GLM-5.3/GLM-5.3-Flash: thinking=provider-default.
UPSTREAM_MODEL=REPLACE_DEFAULT_MODEL
UPSTREAM_PROFILES_JSON=REPLACE_AT_DEPLOY_TIME
