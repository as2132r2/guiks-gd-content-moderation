# Runtime
PORT=3300
APP_MODE=demo
DATABASE_PATH=./data/app.db
MAX_AUDITS=500
FAIL_CLOSED=true

# Production accepts only `base64:` followed by at least 32 random bytes.
# Generate SESSION_SECRET and GATEWAY_TOKEN independently; never reuse them:
# node -e "console.log('base64:'+require('node:crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=

# Demo/test only. Production never creates known-password seed accounts or enables quick login.
SEED_DEMO_USERS=true
DEMO_SEED_PASSWORD=gatekeeper-demo

# Demo mode may use the deterministic built-in model when no upstream is set.
# Set false for a production-like rehearsal.
ALLOW_MOCK_UPSTREAM=true
TARGET_LABEL=县级融媒体中心（演示环境）

# Current adapter expects an OpenAI-compatible Chat Completions base URL.
# Anthropic Messages/SSE support is a separate Track A task. Never commit a real key.
UPSTREAM_URL=
UPSTREAM_KEY=
UPSTREAM_MODEL=GLM-5.2
UPSTREAM_TIMEOUT_MS=30000
# Required for /gateway/v1/messages with a real upstream, and in production.
GATEWAY_TOKEN=

# Optional red-team target. Leave toy mode for the controlled demo target.
TARGET_MODE=toy
TARGET_URL=
TARGET_KEY=
TARGET_FORMAT=openai
TARGET_MODEL=
